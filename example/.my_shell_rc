# my_shell_rc - 起動時に読み込まれる設定ファイル
# コメント行は # で始める。空行は無視される。
# 使えるコマンド: alias, abbr, set, setenv, cd, reg_path

# ── ls エイリアス (Ubuntu bashrc デフォルト相当) ─────────────────────────────
alias ls "ls --color=auto"
alias ll "ls -alF --color=auto"
alias la "ls -A --color=auto"
alias l  "ls -CF --color=auto"

# ── grep エイリアス ───────────────────────────────────────────────────────────
alias grep  "grep --color=auto"
alias fgrep "fgrep --color=auto"
alias egrep "egrep --color=auto"

# ── 安全操作エイリアス ────────────────────────────────────────────────────────
alias cp "cp -i"
alias mv "mv -i"
alias rm "rm -i"

# ── ディレクトリ移動 abbr ─────────────────────────────────────────────────────
abbr ..  "cd .."
abbr ... "cd ../.."
abbr p   popd

# ── cargo abbr ───────────────────────────────────────────────────────────────
abbr c   cargo
abbr cc  "cargo check"
abbr cf  "cargo fmt"
abbr cr  "cargo run"
abbr crr "cargo run --release"
abbr ct  "cargo test"
abbr ctr "cargo test --release"

# ── git abbr ─────────────────────────────────────────────────────────────────
abbr g   git
abbr ga  "git add"
abbr gaa "git add -A"
abbr gb  "git branch"
abbr gc  "git commit"
abbr gca "git commit --amend"
abbr gh  "git checkout"
abbr gd  "git diff"
abbr gf  "git fetch"
abbr gg  "git grep"
abbr gl  "git log --oneline"
abbr gll "git log --oneline -n5"
abbr glg "git log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'"
abbr glv "git log"
abbr gls "git ls-files"
abbr gm  "git merge"
abbr gr  "git remote -v"
abbr gs  "git status -s"
abbr gsh "git show"
abbr gp  "git push"
abbr gst "git status"

# ── 環境変数 ──────────────────────────────────────────────────────────────────
set EDITOR vim
set PAGER  less
